# TaskFlow factory — environment template.
# Copy to `.env` and fill in. The cloud orchestrator reads these from the process
# environment; load them with:  set -a; source .env; set +a
# (never commit the real .env — it is covered by .gitignore)

# --- Cloud Sandboxes auth (run-factory.ts) ----------------------------------
# Docker Personal Access Token. Create at: Docker Hub > Account Settings > PATs.
DOCKER_PAT=

# --- GitHub (clone/push the factory branch from inside each sandbox) ---------
# A token with repo write scope. Locally:  export GITHUB_TOKEN="$(gh auth token)"
GITHUB_TOKEN=
# Target repo the factory operates on, "owner/repo".
GITHUB_REPOSITORY=youruser/taskflow

# --- Agent kit credentials (injected into the kits) --------------------------
# Anthropic — the spec / coding / test / release stages (claude).
ANTHROPIC_API_KEY=
# OpenAI — the cross-model review stage (codex).
OPENAI_API_KEY=

# --- Local-VM orchestrator only (run-factory.sh) -----------------------------
# Registry namespace holding the custom factory-test / factory-release images.
FACTORY_REGISTRY=docker.io/youruser

# To change the reviewer model, edit the review stage directly in
# run-factory.sh / run-factory.ts (codex -> gemini). It is not env-driven.
